<Window x:Class="Filmek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Filmek"
        mc:Ignorable="d"
        Title="Filmek" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" Grid.Column="0">
            <Button Width="250" Height="30" Margin="10" Content="Filmek betöltése" Click="Betolt"/>
            <Button Width="250" Height="30" Margin="10" Content="Hány film van?" Click="osszfilm" />
            <Button Width="250" Height="30" Margin="10" Content="Leghosszabb film?" Click="Leghosszabb"/>
            <Button Width="250" Height="30" Margin="10" Content="Átlag értékelés" Click="Atlag"/>
            <Button Width="250" Height="30" Margin="10" Content="Csak sci-fi" Click="Csakscifi"/>
            <Button Width="250" Height="30" Margin="10" Content="Csak címek" Click="Csakcim"/>
            <Button Width="250" Height="30" Margin="10" Content="Rendezés cím szerint" Click="Cimszerintrendezes"/>
            <ProgressBar x:Name="progressbar" Width="250" Height="20" Margin="15" />
        </StackPanel>
        <StackPanel Grid.Column="1">
            <DataGrid x:Name="datagrid"  Margin="5" MaxHeight="200" SelectionChanged="selectchange"/>
        </StackPanel>
    </Grid>
</Window>
